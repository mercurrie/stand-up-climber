# WebSocket URL of the multiplayer server, baked in at build time.
# Only needed when the game page is hosted somewhere other than the server
# (e.g. GitHub Pages). Leave unset otherwise:
#   - dev: connects to ws://<page-host>:8080
#   - production build served by the Node server: connects to the page's own address
VITE_SERVER_URL=wss://your-server.example.com
